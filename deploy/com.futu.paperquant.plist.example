<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.futu.paperquant</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/gavinyi/.local/bin/uv</string>
    <string>run</string>
    <string>python</string>
    <string>scripts/run_service.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/gavinyi/Documents/My/trade</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/gavinyi/Documents/My/trade/data/service.log</string>
  <key>StandardErrorPath</key><string>/Users/gavinyi/Documents/My/trade/data/service-error.log</string>
</dict>
</plist>
