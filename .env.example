# Futu OpenD must be running and logged in on this machine.
FUTU_HOST=127.0.0.1
FUTU_PORT=11111
# FUTUSECURITIES for a Futu HK account; FUTUINC for a moomoo US account.
FUTU_SECURITY_FIRM=FUTUSECURITIES

# Permanent safety boundary. REAL is deliberately rejected by the application.
FUTU_TRADING_ENV=SIMULATE
FUTU_MARKET=US

# Optional: select one paper account when OpenD returns several.
FUTU_ACC_ID=

# Execution starts disabled. Set true only when you want strategies to submit PAPER orders.
ENABLE_PAPER_ORDERS=false
WATCHLIST=US.SPY,US.QQQ,US.AAPL
ORDER_QUANTITY=1
# Per-symbol quantities managed by the Streamlit configuration page.
ORDER_QUANTITIES={"US.SPY":1,"US.QQQ":1,"US.AAPL":1}
STRATEGY_INTERVAL_SECONDS=300
# Core Satellite portfolio limits. At least 30% remains outside stocks by default.
CORE_SAT_MAX_STOCK_WEIGHT=0.70
OPTION_CONTRACTS=[]
CORE_SAT_PROFILE=balanced
CORE_SAT_REBALANCE_FREQUENCY=weekly
CORE_SAT_WEIGHT_TOLERANCE=0.02
CORE_SAT_MIN_TRADE_USD=1000
CORE_SAT_CORE_BUDGET=0.65
CORE_SAT_SATELLITE_BUDGET=0.15
CORE_SAT_CASH_BUFFER=0.00
CORE_SAT_MAX_SINGLE_REBALANCE_PCT=0.50
CORE_SAT_MAX_ORDER_NOTIONAL=50000
CORE_SAT_HIGH_VOL_DAILY_STD=0.025
CORE_SAT_HIGH_VOL_TRADE_FACTOR=0.50
CORE_SAT_SYMBOLS=US.SPY,US.QQQ,US.NVDA
GAMMA_SYMBOLS=US.NVDA
GAMMA_CAMPAIGNS=[]
# Central execution risk limits. Option notional includes the contract multiplier (normally 100).
RISK_MAX_ORDER_NOTIONAL=20000
RISK_MAX_DAILY_NOTIONAL=100000
RISK_MAX_REDUCTION_ORDER_NOTIONAL=150000
RISK_MAX_DAILY_REDUCTION_NOTIONAL=500000
RISK_MAX_PENDING_ORDERS=20
RISK_MAX_SYMBOL_WEIGHT=0.25
RISK_MAX_GROSS_EXPOSURE=0.85
RISK_MAX_NET_DELTA_PCT=0.70
RISK_MAX_FAMILY_DELTA_PCT=0.30
RISK_MAX_CORRELATED_DELTA_PCT=0.50
RISK_CORRELATION_THRESHOLD=0.80
RISK_MAX_ABS_GAMMA=500
RISK_MAX_ABS_VEGA=50000
RISK_MAX_ABS_THETA=10000
RISK_MAX_OPTION_PREMIUM=30000
RISK_MAX_DAILY_LOSS=5000
RISK_MAX_DRAWDOWN_PCT=0.05
ORDER_TIMEOUT_SECONDS=900
# Unified scheduler. Available: Core Satellite, Earnings Gamma, SMA Cross,
# RSI Mean Reversion, 20 Day Breakout.
SERVICE_STRATEGIES=Core Satellite,Earnings Gamma,Volatility Long Gamma
GAMMA_INTERVAL_SECONDS=30
# Optional generic JSON webhook for risk/order/service alerts.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
EXEC_MAX_SPREAD_PCT=0.20
EXEC_MAX_SLIPPAGE_PCT=0.01
EXEC_REPRICE_INTERVAL_SECONDS=60
EXEC_MAX_REPRICE_ATTEMPTS=3
EXEC_REPRICE_STEP_PCT=0.0025
GAMMA_MAX_ABS_DELTA=1000
GAMMA_MAX_ABS_GAMMA=500
GAMMA_MAX_ABS_VEGA=50000
GAMMA_MAX_IV_RV=2.5
GAMMA_MAX_IV_PERCENTILE=0.95
GAMMA_VOLATILITY_MAX_IV_RV=5.0
GAMMA_VOLATILITY_MAX_IV_PERCENTILE=1.0
VOLATILITY_SYMBOLS=US.NVDA
VOLATILITY_CAMPAIGNS=[]
VOLATILITY_EXPRESSION_REVIEW_SECONDS=300
DATA_RETENTION_DAYS=365
BACKUP_DIR=data/backups
MAX_LOG_BYTES=10485760
EXECUTION_MODE=PAPER
ENFORCE_VIRTUAL_POSITIONS=false
STRATEGY_BUDGETS={"core_satellite":0.65,"earnings_gamma":0.10,"volatility_long_gamma":0.10,"SMA Cross":0.02,"RSI Mean Reversion":0.015,"20 Day Breakout":0.015,"earnings_gamma_manual":0.05}
# PBKDF2-SHA256 password record. Generate it with scripts/set_admin_password.py.
ADMIN_PASSWORD_HASH=
REQUIRE_STRATEGY_APPROVAL=true
APPROVAL_EXEMPT_STRATEGIES=core_satellite
APPROVAL_MIN_SHADOW_DAYS=5
APPROVAL_MIN_SHADOW_ORDERS=5
APPROVAL_MIN_SHADOW_FILL_RATE=0.70
APPROVAL_MAX_SHADOW_SLIPPAGE_PCT=0.01
SHADOW_PARTICIPATION_RATE=0.25
SHADOW_EXTENDED_HOURS_LIQUIDITY=0.35
SHADOW_ORDER_TIMEOUT_SECONDS=900
FEE_STOCK_PER_SHARE=0.005
FEE_STOCK_MINIMUM=1.00
FEE_SELL_REGULATORY_RATE=0.0000278
FEE_OPTION_PER_CONTRACT=0.65
FEE_OPTION_MINIMUM=1.00
EARNINGS_SOURCE_TIMEOUT_SECONDS=4
EARNINGS_SOURCE_OVERALL_TIMEOUT_SECONDS=25
EARNINGS_SOURCE_WORKERS=6
EARNINGS_SOURCE_RETRIES=1
ADMIN_SESSION_TIMEOUT_SECONDS=1800
ADMIN_MAX_LOGIN_ATTEMPTS=5
ADMIN_LOCKOUT_SECONDS=300
