# Futu OpenD must be running and logged in on this machine.
FUTU_HOST=127.0.0.1
FUTU_PORT=11111
FUTU_PREFLIGHT_TIMEOUT_SECONDS=0.5
# FUTUSECURITIES for a Futu HK account; FUTUINC for a moomoo US account.
FUTU_SECURITY_FIRM=FUTUSECURITIES

# Trading environment. Keep SIMULATE for paper trading. REAL requires the
# additional guarded settings below and a short-lived confirmation session.
FUTU_TRADING_ENV=SIMULATE
FUTU_MARKET=US

# Optional: select one paper account when OpenD returns several.
FUTU_ACC_ID=

# Guarded live-trading controls. Defaults are deliberately locked down.
# The app never stores a Futu trade password; unlock real trading in OpenD.
REAL_TRADING_ENABLED=false
REAL_ACCOUNT_ID=
REAL_ALLOWED_STRATEGIES=
REAL_MAX_ORDER_NOTIONAL=500
REAL_MAX_DAILY_NOTIONAL=1000
REAL_REQUIRE_MANUAL_CONFIRM=true

# Execution starts disabled. Set true only when you want strategies to submit PAPER orders.
ENABLE_PAPER_ORDERS=false
WATCHLIST=US.SPY,US.QQQ,US.AAPL
ORDER_QUANTITY=1
# Per-symbol quantities managed by the Streamlit configuration page.
ORDER_QUANTITIES={"US.SPY":1,"US.QQQ":1,"US.AAPL":1}
STRATEGY_INTERVAL_SECONDS=300
# Core Satellite portfolio limits. At least 30% remains outside stocks by default.
CORE_SAT_MAX_STOCK_WEIGHT=0.70
OPTION_CONTRACTS=[]
CORE_SAT_PROFILE=balanced
CORE_SAT_REBALANCE_FREQUENCY=weekly
CORE_SAT_WEIGHT_TOLERANCE=0.02
CORE_SAT_MIN_TRADE_USD=1000
CORE_SAT_CORE_BUDGET=0.65
CORE_SAT_SATELLITE_BUDGET=0.15
CORE_SAT_CASH_BUFFER=0.00
CORE_SAT_MAX_SINGLE_REBALANCE_PCT=0.50
CORE_SAT_MAX_ORDER_NOTIONAL=50000
CORE_SAT_HIGH_VOL_DAILY_STD=0.025
CORE_SAT_HIGH_VOL_TRADE_FACTOR=0.50
CORE_SAT_SYMBOLS=US.SPY,US.QQQ,US.NVDA
GAMMA_SYMBOLS=US.NVDA
GAMMA_CAMPAIGNS=[]
# Central execution risk limits. Option notional includes the contract multiplier (normally 100).
RISK_MAX_ORDER_NOTIONAL=20000
RISK_MAX_DAILY_NOTIONAL=100000
RISK_MAX_REDUCTION_ORDER_NOTIONAL=150000
RISK_MAX_DAILY_REDUCTION_NOTIONAL=500000
RISK_MAX_PENDING_ORDERS=20
RISK_MAX_SYMBOL_WEIGHT=0.25
RISK_MAX_GROSS_EXPOSURE=0.85
RISK_MAX_NET_DELTA_PCT=0.70
RISK_MAX_FAMILY_DELTA_PCT=0.30
RISK_MAX_CORRELATED_DELTA_PCT=0.50
RISK_CORRELATION_THRESHOLD=0.80
RISK_MAX_ABS_GAMMA=500
RISK_MAX_ABS_VEGA=50000
RISK_MAX_ABS_THETA=10000
RISK_MAX_OPTION_PREMIUM=30000
RISK_MAX_DAILY_LOSS=5000
RISK_MAX_DRAWDOWN_PCT=0.05
ORDER_TIMEOUT_SECONDS=900
# Unified scheduler. Available: Core Satellite, Earnings Gamma, SMA Cross,
# RSI Mean Reversion, 20 Day Breakout.
SERVICE_STRATEGIES=Core Satellite,Earnings Gamma,Volatility Long Gamma
GAMMA_INTERVAL_SECONDS=30
# Optional generic JSON webhook for risk/order/service alerts.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
# 任务看板定时器：每天 04:15（中国时间）生成策略复盘与执行质量 HTML，
# 并把结论登记为“待 DSH IM 投递”记录；DSH 侧定时 agent 到点读取该记录，
# 用 agent 能力把复盘总结投递到已接好的微信 chat（dsh IM 插件通道），
# 投递成功后回写 delivered，避免重发。
# 每天 04:30 自动关机，默认关闭，建议先用 AUTO_SHUTDOWN_DRY_RUN=true 演练。
AUTO_COMPUTER_SHUTDOWN_ENABLED=false
AUTO_SHUTDOWN_DRY_RUN=true
EXEC_MAX_SPREAD_PCT=0.20
EXEC_MAX_SLIPPAGE_PCT=0.01
EXEC_REPRICE_INTERVAL_SECONDS=60
EXEC_MAX_REPRICE_ATTEMPTS=3
EXEC_REPRICE_STEP_PCT=0.0025
GAMMA_MAX_ABS_DELTA=1000
GAMMA_MAX_ABS_GAMMA=500
GAMMA_MAX_ABS_VEGA=50000
GAMMA_MAX_IV_RV=2.5
GAMMA_MAX_IV_PERCENTILE=0.95
GAMMA_VOLATILITY_MAX_IV_RV=2.5
GAMMA_VOLATILITY_MAX_IV_PERCENTILE=0.85
GAMMA_VOLATILITY_MAX_ABSOLUTE_IV=0.85
VOLATILITY_SYMBOLS=US.COIN,US.AMD,US.NVDA,US.AVGO,US.AAPL,US.META,US.AMZN,US.GOOG,US.MSFT,US.TSM,US.QQQ,US.SPY,US.GLD
VOLATILITY_CAMPAIGNS=[]
VOLATILITY_EXPRESSION_REVIEW_SECONDS=300
VOLATILITY_EXPECTED_RETURN_MIN_NORMAL=0.02
VOLATILITY_EXPECTED_RETURN_MIN_DYNAMIC=0.005
VOLATILITY_EXPECTED_RETURN_MIN_STRONG=0.0

# ML模型配置 (波动率策略标的筛选)
ML_ENABLED=true
ML_MODEL_PATH=data/ml_models/volatility_scorer_v3.pkl
ML_THRESHOLD=0.5
ML_WEIGHT=0.6
DATA_RETENTION_DAYS=365
BACKUP_DIR=data/backups
MAX_LOG_BYTES=10485760
EXECUTION_MODE=PAPER
ENFORCE_VIRTUAL_POSITIONS=false
STRATEGY_BUDGETS={"core_satellite":0.65,"earnings_gamma":0.10,"volatility_long_gamma":0.10,"SMA Cross":0.02,"RSI Mean Reversion":0.015,"20 Day Breakout":0.015,"earnings_gamma_manual":0.05}
# PBKDF2-SHA256 password record. Generate it with scripts/set_admin_password.py.
ADMIN_PASSWORD_HASH=
REQUIRE_STRATEGY_APPROVAL=true
APPROVAL_EXEMPT_STRATEGIES=core_satellite
APPROVAL_MIN_SHADOW_DAYS=5
APPROVAL_MIN_SHADOW_ORDERS=5
APPROVAL_MIN_SHADOW_FILL_RATE=0.70
APPROVAL_MAX_SHADOW_SLIPPAGE_PCT=0.01
SHADOW_PARTICIPATION_RATE=0.25
SHADOW_EXTENDED_HOURS_LIQUIDITY=0.35
SHADOW_ORDER_TIMEOUT_SECONDS=900
FEE_STOCK_PER_SHARE=0.005
FEE_STOCK_MINIMUM=1.00
FEE_SELL_REGULATORY_RATE=0.0000278
FEE_OPTION_PER_CONTRACT=0.65
FEE_OPTION_MINIMUM=1.00
EARNINGS_SOURCE_TIMEOUT_SECONDS=4
EARNINGS_SOURCE_OVERALL_TIMEOUT_SECONDS=25
EARNINGS_SOURCE_WORKERS=6
EARNINGS_SOURCE_RETRIES=1
ADMIN_SESSION_TIMEOUT_SECONDS=1800
ADMIN_MAX_LOGIN_ATTEMPTS=5
ADMIN_LOCKOUT_SECONDS=300

# OKX crypto quant. Version 1 is hard-locked to Demo Trading and SPOT.
OKX_TRADING_MODE=DEMO
OKX_BASE_URL=https://openapi.okx.com
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_ENABLE_DEMO_ORDERS=false
OKX_TIMEOUT_SECONDS=10
OKX_RETRY_ATTEMPTS=2
OKX_RETRY_BACKOFF_SECONDS=0.8
OKX_MAX_ORDER_NOTIONAL=500
CRYPTO_EXECUTION_MODE=SHADOW
CRYPTO_VOLATILITY_SYMBOLS=BTC-USDT,ETH-USDT
CRYPTO_RADAR_ENABLED=false
CRYPTO_RADAR_AUTO_ADD=false
CRYPTO_RADAR_UNIVERSE=BTC-USDT,ETH-USDT,SOL-USDT,XRP-USDT,DOGE-USDT,ADA-USDT,AVAX-USDT,LINK-USDT
CRYPTO_RADAR_MAX_SYMBOLS_PER_CYCLE=5
CRYPTO_RADAR_MANAGED_SYMBOLS=
CRYPTO_RADAR_MAX_MANAGED_SYMBOLS=10
CRYPTO_RADAR_EXIT_INACTIVE_CYCLES=24
CRYPTO_RADAR_FULL_SCAN_ENABLED=true
CRYPTO_RADAR_MIN_AUTO_ADD_SCORE=60
CRYPTO_VOLATILITY_BUDGET=1000
CRYPTO_MAX_ORDER_NOTIONAL=500
CRYPTO_INTERVAL_SECONDS=300
CRYPTO_REGIME_FILTER_ENABLED=true
CRYPTO_TREND_WINDOW=120
CRYPTO_MIN_TREND_STRENGTH=0.005
CRYPTO_MAX_CHASE_ATR=8.0
CRYPTO_TREND_PARTICIPATION_ENABLED=true
CRYPTO_TREND_PARTICIPATION_MIN_24H_RETURN=0.030
CRYPTO_TREND_PARTICIPATION_MIN_72H_RETURN=0.045
CRYPTO_TREND_PARTICIPATION_MAX_RSI=75
CRYPTO_TREND_PARTICIPATION_MAX_BOLLINGER=1.10
CRYPTO_TREND_PARTICIPATION_MIN_VOLUME_RATIO=0.70
CRYPTO_TREND_PARTICIPATION_POSITION_SCALE=0.45
CRYPTO_HIGHER_TIMEFRAME_ENABLED=true
CRYPTO_HIGHER_TIMEFRAME_BAR=4H
CRYPTO_HIGHER_TIMEFRAME_MIN_BARS=80
CRYPTO_HIGHER_TIMEFRAME_MIN_TREND_RETURN=0
CRYPTO_WEAK_MOMENTUM_EXIT_ENABLED=true
CRYPTO_WEAK_MOMENTUM_EXIT_HOURS=12
CRYPTO_WEAK_MOMENTUM_EXIT_MAX_PNL=0
CRYPTO_WEAK_MOMENTUM_EXIT_MIN_PEAK_PNL=0.008
CRYPTO_VOL_TARGET_VOLATILITY=0.80
CRYPTO_VOL_HARD_STOP=0.08
CRYPTO_VOL_PROFIT_PROTECTION_START=0.10
CRYPTO_VOL_PROFIT_GIVEBACK=0.30
CRYPTO_VOL_MINIMUM_LOCKED_PROFIT=0.04
CRYPTO_VOL_TACTICAL_PROFIT_PROTECTION_START=0.015
CRYPTO_VOL_TACTICAL_PROFIT_GIVEBACK=0.55
CRYPTO_VOL_TACTICAL_MINIMUM_LOCKED_PROFIT=0.002
CRYPTO_PARTIAL_PROFIT_TIER1=0.025
CRYPTO_PARTIAL_PROFIT_TIER1_FRACTION=0.50
CRYPTO_PARTIAL_PROFIT_TIER2=0.050
CRYPTO_PARTIAL_PROFIT_TIER2_FRACTION=0.25
CRYPTO_MAX_HOLD_HOURS=120
CRYPTO_CONTRACTION_RATIO=0.75
CRYPTO_CONTRACTION_CONFIRMATIONS=3
CRYPTO_COOLDOWN_HOURS=6
CRYPTO_MAX_OPEN_POSITIONS=3
CRYPTO_MAX_TOTAL_EXPOSURE=3000
CRYPTO_MAX_PORTFOLIO_DRAWDOWN=0.15
CRYPTO_MAX_DAILY_TRADES=12
CRYPTO_MAX_CONSECUTIVE_LOSSES=3
CRYPTO_LOSS_LOCK_HOURS=24

# OKX Demo USDT perpetual swaps. Independent from the spot strategy.
CRYPTO_SWAP_SYMBOLS=BTC-USDT-SWAP,ETH-USDT-SWAP
CRYPTO_SWAP_EXECUTION_MODE=SHADOW
CRYPTO_SWAP_ENGINE=MANAGED_FUTURES
CRYPTO_SWAP_ENTRY_ENABLED=false
CRYPTO_SWAP_ALT_SHORT_ENABLED=true
CRYPTO_SWAP_ALLOW_MAJOR_SHORT=false
CRYPTO_SWAP_ALT_SHORT_EXCLUDED_BASES=BTC,ETH
CRYPTO_SWAP_MF_SCORE_THRESHOLD=65
CRYPTO_SWAP_MF_RELATIVE_WEAKNESS=-0.015
CRYPTO_SWAP_MF_MIN_VOLUME_RATIO=0.80
CRYPTO_SWAP_MF_MAX_NEGATIVE_FUNDING_SHORT=-0.001
CRYPTO_SWAP_ALT_SHORT_INITIAL_MARGIN_FRACTION=0.35
CRYPTO_SWAP_ALT_SHORT_ADD_LOSS_STEPS=0.03,0.06,0.10
CRYPTO_SWAP_ALT_SHORT_ADD_MARGIN_MULTIPLIERS=1.0,1.2,1.5
CRYPTO_SWAP_ALT_SHORT_MAX_LAYERS=3
CRYPTO_SWAP_ALT_SHORT_RECOVERY_TAKE_PROFIT=0.008
CRYPTO_SWAP_ALT_SHORT_MAX_POSITION_LOSS=0.12
CRYPTO_SWAP_MF_TREND_INVALIDATION_SCORE=45
CRYPTO_SWAP_MF_BENCHMARK_SYMBOL=BTC-USDT-SWAP
CRYPTO_SWAP_INTERVAL_SECONDS=300
CRYPTO_SWAP_LEVERAGE=2
CRYPTO_SWAP_MARGIN_BUDGET=500
CRYPTO_SWAP_MAX_OPEN_POSITIONS=3
CRYPTO_SWAP_MAX_TOTAL_MARGIN=1500
CRYPTO_SWAP_MAX_MARGIN_PER_POSITION=500
CRYPTO_SWAP_MAX_LEVERAGE=3
CRYPTO_SWAP_SHORT_PROFIT_PROTECTION_START=0.08
CRYPTO_SWAP_SHORT_PROFIT_GIVEBACK=0.25
CRYPTO_SWAP_PARTIAL_PROFIT_TIER1=0.08
CRYPTO_SWAP_PARTIAL_PROFIT_TIER1_FRACTION=0.50
CRYPTO_SWAP_PARTIAL_PROFIT_TIER2=0.16
CRYPTO_SWAP_PARTIAL_PROFIT_TIER2_FRACTION=0.25
CRYPTO_SWAP_MIN_HOLD_HOURS=1
CRYPTO_SWAP_FUNDING_EXIT_RATE=0.0015
CRYPTO_SWAP_LIQUIDATION_BUFFER_EXIT=0.15
CRYPTO_SWAP_RADAR_ENABLED=false
CRYPTO_SWAP_RADAR_AUTO_ADD=false
CRYPTO_SWAP_RADAR_UNIVERSE=BTC-USDT-SWAP,ETH-USDT-SWAP,SOL-USDT-SWAP,XRP-USDT-SWAP,DOGE-USDT-SWAP,ADA-USDT-SWAP,AVAX-USDT-SWAP,LINK-USDT-SWAP
CRYPTO_SWAP_RADAR_MAX_PER_CYCLE=5
CRYPTO_SWAP_RADAR_MAX_MANAGED=8
CRYPTO_SWAP_RADAR_EXIT_CYCLES=24
CRYPTO_SWAP_RADAR_FULL_SCAN_ENABLED=true
CRYPTO_SWAP_RADAR_MIN_AUTO_ADD_SCORE=60
CRYPTO_SWAP_MAX_ABS_FUNDING_RATE=0.001
CRYPTO_SWAP_MAX_SPREAD_RATIO=0.002

# 任务看板定时关机配置 (物理关机已交由 Windows 任务计划程序接管)
AUTO_COMPUTER_SHUTDOWN_ENABLED=false
AUTO_SHUTDOWN_DRY_RUN=false
REAL_SHUTDOWN_ENABLED=false

# 标的池流水线自动化任务配置
AUTO_WEEKLY_UNIVERSE_RECALL_ENABLED=true
AUTO_DAILY_UNIVERSE_RANKING_ENABLED=true
